{
  "version": 1,
  "notes": "浏览器文章读取评测任务集。url 中 {{BASE}} 由 runner 替换为测试页目录的 file:// URL。type=pipeline 为零模型管线断言（run-pipeline.mjs 执行）；type=antibot 为 fetch 白名单分流断言（runner 自建本地 http server，对普通 fetch 返回 403、对真实浏览器导航返回文章页）；type=agent 为需模型驱动浏览器工具的探索任务（基线采集用，runner 跳过），其中 search 类任务无 url 字段、走真实搜索引擎（依赖网络与代理配置），断言用 expect.tools（必调用工具）与 expect.minUrls（回复/工具输出去重 URL 数下限），search-agent-site-* 需在 search 传 site 参数走站内搜索（reddit 依赖代理存活）。",
  "tasks": [
    {
      "id": "spa-pipeline-read",
      "type": "pipeline",
      "action": "readArticle",
      "url": "{{BASE}}/spa-article.html",
      "scenario": "正文由 JS 延迟 2s 注入，管线渲染等待应等到正文",
      "expect": {
        "ok": true,
        "contains": ["DOGEAR-EVAL-MARK-SPA-1"],
        "wordCountMin": 350,
        "titleContains": "SPA"
      }
    },
    {
      "id": "spa-pipeline-noexpand-hint",
      "type": "pipeline",
      "action": "readArticle",
      "url": "{{BASE}}/spa-article.html",
      "scenario": "无展开候选的完整页面：不应误示 qualityHint",
      "expect": {
        "ok": true,
        "contains": ["DOGEAR-EVAL-MARK-SPA-2"],
        "qualityHint": "absent"
      }
    },
    {
      "id": "collapsed-pipeline-expand",
      "type": "pipeline",
      "action": "readArticle",
      "url": "{{BASE}}/collapsed.html",
      "scenario": "摘要可见正文隐藏，展开启发式点击「展开全文」后可见字数变长",
      "expect": {
        "ok": true,
        "contains": ["DOGEAR-EVAL-MARK-COLLAPSED-1"],
        "wordCountMin": 420,
        "qualityHint": "absent"
      }
    },
    {
      "id": "collapsed-pipeline-full",
      "type": "pipeline",
      "action": "readArticle",
      "url": "{{BASE}}/collapsed.html",
      "scenario": "展开后尾部标记可达，验证全文提取",
      "expect": {
        "ok": true,
        "contains": ["DOGEAR-EVAL-MARK-COLLAPSED-2"],
        "qualityHint": "absent"
      }
    },
    {
      "id": "paged-pipeline-longest",
      "type": "pipeline",
      "action": "readArticle",
      "url": "{{BASE}}/paged.html",
      "scenario": "三页翻页：翻页循环拼接全量内容，三页标记全部存在",
      "expect": {
        "ok": true,
        "contains": [
          "DOGEAR-EVAL-MARK-PAGED-1",
          "DOGEAR-EVAL-MARK-PAGED-2",
          "DOGEAR-EVAL-MARK-PAGED-3"
        ],
        "wordCountMin": 1000,
        "qualityHint": "absent"
      }
    },
    {
      "id": "paged-pipeline-title",
      "type": "pipeline",
      "action": "readArticle",
      "url": "{{BASE}}/paged.html",
      "scenario": "翻页拼接后标题取第一页，且拼接内容完整",
      "expect": {
        "ok": true,
        "contains": ["DOGEAR-EVAL-MARK-PAGED-1", "DOGEAR-EVAL-MARK-PAGED-3"],
        "titleContains": "翻页"
      }
    },
    {
      "id": "paged-url-pipeline-concat",
      "type": "pipeline",
      "action": "readArticle",
      "url": "{{BASE}}/paged-url.html",
      "scenario": "URL 跳转型三页翻页：点击后真导航，拼接全量内容，标题取第一页",
      "expect": {
        "ok": true,
        "contains": [
          "DOGEAR-EVAL-MARK-PAGEDURL-1",
          "DOGEAR-EVAL-MARK-PAGEDURL-2",
          "DOGEAR-EVAL-MARK-PAGEDURL-3"
        ],
        "wordCountMin": 1000,
        "titleContains": "URL 翻页",
        "qualityHint": "absent"
      }
    },
    {
      "id": "login-pipeline-needlogin",
      "type": "pipeline",
      "action": "readArticle",
      "url": "{{BASE}}/login-wall.html",
      "scenario": "密码框存在且隐藏正文藏在标准容器（article）内，可见性度量后 DOM 登录墙检测应命中 need_login",
      "expect": {
        "ok": false,
        "errorClass": "need_login"
      }
    },
    {
      "id": "lazy-pipeline-read",
      "type": "pipeline",
      "action": "readArticle",
      "url": "{{BASE}}/lazy-images.html",
      "scenario": "懒加载图片长文，文字正文应完整提取（图片不参与字数）",
      "expect": {
        "ok": true,
        "contains": ["DOGEAR-EVAL-MARK-LAZY-1"],
        "wordCountMin": 450
      }
    },
    {
      "id": "odd-pipeline-readability",
      "type": "pipeline",
      "action": "readArticle",
      "url": "{{BASE}}/odd-container.html",
      "scenario": "非标准容器：Readability 兜底应选中正文并剥离侧栏噪音",
      "expect": {
        "ok": true,
        "contains": ["DOGEAR-EVAL-MARK-ODD-1"],
        "notContains": ["DOGEAR-EVAL-MARK-ODD-NOISE"],
        "wordCountMin": 350
      }
    },
    {
      "id": "antibot-pipeline-fallback",
      "type": "antibot",
      "action": "readArticle",
      "scenario": "fetch 层被 403 反爬拦截：错误应结构化为 FetchError(status=403) 并命中白名单，分流后浏览器层应救活页面",
      "expect": {
        "ok": true,
        "contains": ["DOGEAR-EVAL-MARK-ANTIBOT-1"]
      }
    },
    {
      "id": "spa-agent-find-mark",
      "type": "agent",
      "action": "explore",
      "url": "{{BASE}}/spa-article.html",
      "goal": "页面正文延迟 2 秒才注入。用 dogear-browser 工具（navigate 后 wait_for）等到正文出现，再用 read_text 读正文，找到标记文本 DOGEAR-EVAL-MARK-SPA-2",
      "expect": {
        "found": ["DOGEAR-EVAL-MARK-SPA-2"]
      }
    },
    {
      "id": "collapsed-agent-explore",
      "type": "agent",
      "action": "explore",
      "url": "{{BASE}}/collapsed.html",
      "goal": "正文默认隐藏。用 observe_page 找到「展开全文」按钮并 click，再用 read_text 读正文，找到标记文本 DOGEAR-EVAL-MARK-COLLAPSED-2",
      "expect": {
        "found": ["DOGEAR-EVAL-MARK-COLLAPSED-2"]
      }
    },
    {
      "id": "paged-agent-explore",
      "type": "agent",
      "action": "explore",
      "url": "{{BASE}}/paged.html",
      "goal": "文章分 3 页展示。用 observe_page 找到「下一页」按钮，连续 click 两次直到按钮消失，用 read_text 确认当前在第 3 页，找到标记文本 DOGEAR-EVAL-MARK-PAGED-3",
      "expect": {
        "found": ["DOGEAR-EVAL-MARK-PAGED-3"]
      }
    },
    {
      "id": "login-agent-flow",
      "type": "agent",
      "action": "explore",
      "url": "{{BASE}}/login-wall.html",
      "goal": "页面被登录墙保护。用 observe_page 找到密码输入框，fill 任意值后 click 登录按钮，再用 readArticle 或 read_text 读取正文，找到标记文本 DOGEAR-EVAL-MARK-LOGIN-OK-1",
      "expect": {
        "found": ["DOGEAR-EVAL-MARK-LOGIN-OK-1"]
      }
    },
    {
      "id": "lazy-agent-explore",
      "type": "agent",
      "action": "explore",
      "url": "{{BASE}}/lazy-images.html",
      "goal": "长文含懒加载图片。navigate 后用 wait_for 等尾部文本出现，read_text 确认正文完整，找到标记文本 DOGEAR-EVAL-MARK-LAZY-2",
      "expect": {
        "found": ["DOGEAR-EVAL-MARK-LAZY-2"]
      }
    },
    {
      "id": "odd-agent-explore",
      "type": "agent",
      "action": "explore",
      "url": "{{BASE}}/odd-container.html",
      "goal": "正文容器为非标准结构且周边有导航与侧栏噪音。用 read_text 读取正文区域，找到标记文本 DOGEAR-EVAL-MARK-ODD-2，且不要被侧栏的 DOGEAR-EVAL-MARK-ODD-NOISE 干扰",
      "expect": {
        "found": ["DOGEAR-EVAL-MARK-ODD-2"]
      }
    },
    {
      "id": "search-agent-top-results",
      "type": "agent",
      "action": "search",
      "goal": "不知道具体网址时需要先搜索发现内容。用 dogear__browser__search 工具搜索关键词「playwright patchright 反检测」，把搜索返回的前 5 条结果在最终回复中逐条列出，每条包含标题、完整 URL 和一句话摘要",
      "expect": {
        "tools": ["dogear__browser__search"],
        "minUrls": 3
      }
    },
    {
      "id": "search-agent-read-article",
      "type": "agent",
      "action": "search",
      "goal": "搜索发现与阅读的组合任务。先用 dogear__browser__search 搜索「MDN Fetch API 文档」，从结果中挑一条 developer.mozilla.org 的文档 URL，再用 dogear__browser__readArticle 读取该页面。最终回复中给出：所选结果的完整 URL、读取到的文章标题、以及不超过三句话的内容摘要",
      "expect": {
        "tools": ["dogear__browser__search", "dogear__browser__readArticle"],
        "minUrls": 2
      }
    },
    {
      "id": "search-agent-site-reddit",
      "type": "agent",
      "action": "search",
      "goal": "需要站内互动量排序的搜索。调用 dogear__browser__search 时传 site=\"reddit\"，搜索关键词「home renovation mistakes」，把返回的前 3 条结果逐条列出，每条包含标题、完整 URL、一句话摘要与互动量信息（score/评论数/subreddit）",
      "expect": {
        "tools": ["dogear__browser__search"],
        "minUrls": 2
      }
    },
    {
      "id": "search-agent-site-zhihu",
      "type": "agent",
      "action": "search",
      "goal": "需要站内高赞排序的搜索。调用 dogear__browser__search 时传 site=\"zhihu\"，搜索关键词「装修 避坑」，把返回的前 3 条结果逐条列出，每条包含标题、完整 URL、一句话摘要与赞同数/作者",
      "expect": {
        "tools": ["dogear__browser__search"],
        "minUrls": 2
      }
    }
  ]
}
