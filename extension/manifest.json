{
  "manifest_version": 3,
  "name": "Dogear 连接器",
  "version": "0.6.0",
  "description": "将当前标签页快照发送给 Dogear 桌面应用",
  "key": "",
  "permissions": ["nativeMessaging", "activeTab", "scripting", "storage", "tabs", "contextMenus", "alarms"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dogear",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  }
}
