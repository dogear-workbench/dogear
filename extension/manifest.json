{
  "manifest_version": 3,
  "name": "Dogear 连接器",
  "version": "0.3.0",
  "description": "将当前标签页快照发送给 Dogear 桌面应用",
  "key": "",
  "permissions": ["nativeMessaging", "activeTab", "scripting", "storage", "tabs", "tabGroups", "contextMenus", "alarms"],
  "optional_host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dogear"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  }
}
