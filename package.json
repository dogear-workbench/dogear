{
  "name": "dogear",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    // 开发模式：同时启动 Next.js 开发服务器和 Electron 应用
    "dev": "concurrently \"npm run dev:next\" \"npm run dev:electron\"",
    // 启动 Next.js 开发服务器（端口 3000）
    "dev:next": "next dev",
    // 等待 Next.js 服务器启动后再启动 Electron
    // 使用 wait-on 确保端口 3000 可用，设置开发环境变量
    "dev:electron": "wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .",
    // 构建 Next.js 应用为静态文件
    "build:next": "next build",
    // 编译 Electron 主进程 TypeScript 代码
    "build:electron": "tsc -p tsconfig.electron.json",
    // 完整构建：先构建 Next.js，再编译 Electron
    "build": "npm run build:next && npm run build:electron",
    // 使用 electron-builder 打包应用为可执行文件
    "dist": "npm run build && electron-builder",
    // 运行代码检查
    "lint": "eslint ."
  },
  "dependencies": {
    "better-sqlite3": "^12.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "epub2": "^3.0.2",
    "iconv-lite": "^0.7.2",
    "lucide-react": "^0.562.0",
    "next": "16.1.2",
    "pdf-parse": "^2.4.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "electron-is-dev": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wait-on": "^9.0.3"
  }
}
