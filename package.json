{
  "name": "dogear",
  "version": "0.1.156",
  "description": "AI 驱动的个人工作台",
  "author": "Dogear Team",
  "main": "dist/main/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:electron && concurrently \"bun run dev:renderer\" \"bun run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .",
    "dev:watch": "concurrently \"bun run dev:renderer\" \"bun run watch:electron\" \"bun run dev:electron\"",
    "watch:electron": "tsc -p tsconfig.electron.json --watch",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "bun run build:renderer && bun run build:electron",
    "dist": "bun run build && node scripts/build-nm-manifest.mjs && electron-builder",
    "postdist": "node scripts/prune-release.mjs",
    "postinstall": "electron-rebuild",
    "lint": "eslint .",
    "test": "bun test",
    "release": "node scripts/release.mjs",
    "serve-updates": "node scripts/serve-updates.mjs",
    "bench:chat-render": "bun run scripts/chat-render-benchmark.ts",
    "kill": "node scripts/kill-processes.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.83.0",
    "@earendil-works/pi-ai": "^0.83.0",
    "@egoist/tipc": "^0.3.2",
    "@headless-tree/core": "^1.6.3",
    "@headless-tree/react": "^1.6.3",
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/typography": "^0.5.19",
    "@tencent-weixin/openclaw-weixin": "^2.1.3",
    "@tiptap/extension-image": "3.30.5",
    "@tiptap/extension-link": "3.30.5",
    "@tiptap/extension-list": "3.30.5",
    "@tiptap/extension-table": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "@tiptap/suggestion": "3.30.5",
    "@types/uuid": "^10.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.6.0",
    "bonjour-service": "^1.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "highlight.js": "^11.11.1",
    "iconv-lite": "^0.7.2",
    "lightweight-charts": "^5.1.0",
    "linkedom": "^0.18.12",
    "lucide-react": "^0.562.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-router": "^7.13.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tiptap-markdown": "0.9.0",
    "turndown": "^7.2.2",
    "uuid": "^13.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron/asar": "^4.1.1",
    "@electron/rebuild": "^4.0.3",
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/bun": "^1.4.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "cpy-cli": "^7.0.0",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "electron-is-dev": "^3.0.1",
    "eslint": "^9",
    "pngjs": "^5.0.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.3"
  },
  "patchedDependencies": {
    "@earendil-works/pi-agent-core@0.83.0": "patches/@earendil-works%2Fpi-agent-core@0.83.0.patch"
  }
