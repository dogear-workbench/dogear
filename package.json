{
  "name": "dogear",
  "version": "0.1.0",
  "description": "AI-powered eBook reader for EPUB and PDF files",
  "author": "Dogear Team",
  "main": "dist/main/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:electron && concurrently \"npm run dev:next\" \"npm run dev:electron\"",
    "dev:next": "next dev",
    "dev:electron": "wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .",
    "build:next": "next build",
    "dev:watch": "concurrently \"npm run dev:next\" \"npm run watch:electron\" \"npm run dev:electron\"",
    "watch:electron": "tsc -p tsconfig.electron.json --watch",
    "build:electron": "tsc -p tsconfig.electron.json && cpy \"electron/main/database/*.sql\" dist/main/database/",
    "build": "npm run build:next && npm run build:electron",
    "dist": "npm run build && electron-builder",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.39",
    "@egoist/tipc": "^0.3.2",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/typography": "^0.5.19",
    "@types/uuid": "^10.0.0",
    "better-sqlite3": "^12.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "epub2": "^3.0.2",
    "highlight.js": "^11.11.1",
    "iconv-lite": "^0.7.2",
    "linkedom": "^0.18.12",
    "lucide-react": "^0.562.0",
    "next": "16.1.2",
    "pdf-parse": "^2.4.5",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "turndown": "^7.2.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "concurrently": "^9.2.1",
    "cpy-cli": "^7.0.0",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "electron-is-dev": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wait-on": "^9.0.3"
  }
}
